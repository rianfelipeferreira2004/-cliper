# ===== FreeClip — configurações (copie para .env e ajuste se quiser) =====

# Porta do servidor web
PORT=3000

# Limite de upload de vídeo em MB (padrão: 2048 = 2 GB)
MAX_UPLOAD_MB=2048

# Duração máxima do corte em minutos (padrão: 3)
MAX_CLIP_MINUTES=3

# Renders simultâneos na fila.
# Vazio/comentado = automático (1 em host fraco com até 2 CPUs, 2 no resto).
# Em plano free, deixe automático ou force 1.
# MAX_RENDER_JOBS=2

# Apagar automaticamente clipes com mais de N dias (padrão: 7)
CLEANUP_DAYS=7

# Quantas resoluções de link da Kick por minuto são permitidas por IP
RESOLVE_RATE_LIMIT=10
